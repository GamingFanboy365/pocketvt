# --- Local reference material: never commit ---
# ROMs: test carts, controls, and everything builder.py / build_playable.sh
# produce (play_me.gba, out/*.gba).  The ONLY ROM-like files in git are the
# repo-root pocketvt.elf / pocketvt.gba core (re-included under Build output).
*.nes
*.unf
*.unif
*.fds
*.qd
*.nsf
*.nsfe
*.tnes
*.mb
*.agb
testroms/
out/
# NESdev wiki exports, NintendulatorNRS snippets, and the full Furbtendulator
# emulator source (unpacked as reference/Furbtendulator-main)
reference/
Furbtendulator*/
Furbtendulator*.zip
NESdev_Wiki-*.xml
# Reference screenshots / captures and harness frame dumps
*.png
!src/**/*.png
*.ppm
*.raw
*.idx
# compare_furb.py output
furbcmp/

# --- Build output ---
build/
pvt_build/
*_build/
*.o
*.d
*.elf
*.map
*.gba
*.sav
play_me.gba
# ...except the committed core at the repo root, rebuilt by CI on every PR
# (.github/workflows/build.yml)
!/pocketvt.elf
!/pocketvt.gba

